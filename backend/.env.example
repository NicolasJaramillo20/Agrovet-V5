PORT=5000
MONGODB_URI=mongodb://localhost:27017/agrovet
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-chars
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@agrovet.co
ADMIN_PASSWORD=ChangeMe123!

# Optional Neon/PostgreSQL pooled connection string. Neon CLI writes DATABASE_URL
# to the project-root .env.local; the backend loads it automatically.
DATABASE_URL=
# Local PostgreSQL fallback; used only when DATABASE_URL and POSTGRES_URL are unset.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=agrovet
POSTGRES_USER=agrovet_app
POSTGRES_PASSWORD=replace-with-your-postgres-password

# MySQL is a separate local server and stores invoices.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agrovet_mysql
MYSQL_USER=agrovet_app
MYSQL_PASSWORD=replace-with-your-mysql-password

# Google Identity Services (same OAuth client ID in backend and frontend).
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173

# SMTP settings are required to send password-recovery links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
